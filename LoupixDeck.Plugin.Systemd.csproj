<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>default</LangVersion>
    <DebugType>embedded</DebugType>

    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Restored from nuget.org. The host ships the SDK assembly at runtime,
         so the runtime asset must never be copied next to the plugin. -->
    <PackageReference Include="LoupixDeck.PluginSdk" Version="1.24.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>

    <!-- The plugin talks to systemd over D-Bus. Same library and version as the other
         Linux plugins in this workspace. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The host reads these straight off disk next to plugin.json, so they have to be copied
         like any other content file. -->
    <Content Include="strings.*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
